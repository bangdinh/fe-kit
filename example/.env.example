# Chọn MỘT môi trường; mọi endpoint đi theo. Bảng ở shared/src/env.ts.
APP_ENV=uat

# Secret của web confidential client. KHÔNG commit giá trị thật.
OIDC_CLIENT_SECRET=

# Đè từng endpoint khi chạy một service ở local/devtunnel (tuỳ chọn).
# API_GATEWAY_URI=
# SSO_ISSUER_URI=

# debug | info | warn | error
LOG_LEVEL=debug

# Body API đầy đủ trong log, VẪN che token. Bật khi đang truy một lỗi cụ thể.
# LOG_HTTP_FULL_BODY=1
